    <div>
{% if p.first %}
      <h3>הערות הייעוץ</h3>
{% endif %}
{% for a in p.chunk %}
      <div class="adv adv--{{ a.level }}">
        <span class="adv-level"></span>
        <div><b>{{ a.title | ltr }}</b> · {{ a.body | ltr }}<div class="adv-meta">{{ a.grade }} · מקור {{ num(a.src) }}</div></div>
      </div>
{% else %}
      <p class="lead">אין הערות ייעוץ לתכנון הזה.</p>
{% endfor %}
    </div>
{% if p.last is defined %}
    <div class="declare">התיק הוא בריף תכנון מהלקוח לנגר, לא חוזה ולא אישור הנדסי. המידות משוערות עד מדידה באתר. רשימת החיתוך היא טיוטה לפי שיטת הבנייה המוצהרת בעמוד החומרים. טובין שמיוצרים לפי מידה אינם ניתנים לביטול {{ num("[115]") }}. לפני הזמנה, הנגר מאשר את המידות הסופיות בכתב.</div>
{% endif %}
