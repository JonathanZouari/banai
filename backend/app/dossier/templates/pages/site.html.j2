    <div>
      <h3>{{ t("מידות אתר (משוערות, מפי הלקוח)") }}</h3>
      <dl class="kv">
        <div><dt>{{ t("גובה תקרה") }}</dt><dd>{% if p.ceiling %}{{ num(p.ceiling) }}{% else %}{{ t("לא נמסר") }}{% endif %}</dd></div>
{% if p.heights %}        <div><dt>{{ t("גובה בשלוש נקודות") }}</dt><dd>{{ p.heights }}</dd></div>
{% endif %}        <div><dt>{{ t("רוחב נישה (הקטן מ-3)") }}</dt><dd>{% if p.niche %}{{ num(p.niche) }}{% else %}{{ t("לא נמסר") }}{% endif %}</dd></div>
{% if p.widths %}        <div><dt>{{ t("רוחב בשלושה גבהים") }}</dt><dd>{{ p.widths }}</dd></div>
{% endif %}        <div><dt>{{ t("פילר לכל צד") }}</dt><dd>{% if p.filler is not none %}{{ num(p.filler | mm) }}{% else %}—{% endif %}</dd></div>
        <div><dt>{{ t("אלכסון הרמה {formula}", formula=num("√(H²+D²)")) }}</dt><dd>
{% if p.lift_ok is none %}{{ num(p.diagonal | mm) }}
{% else %}<span class="{{ 'ok' if p.lift_ok else 'bad' }}">{{ num(p.diagonal | mm) }} · {{ t("עובר") if p.lift_ok else t("לא עובר") }}</span>{% endif %}
        </dd></div>
        <div><dt>{{ t("עוגנים לשלד") }}</dt><dd>{{ t("{n} (לפי רוחב {w} ס״מ)", n=p.anchors, w=lay.width | cm) }}</dd></div>
{% if p.obstacles %}        <div><dt>{{ t("מכשולים בקיר") }}</dt><dd>{% for o in p.obstacles %}{{ o }}{% if not loop.last %}<br>{% endif %}{% endfor %}</dd></div>
{% endif %}        <div><dt>{{ t("מרחב פנוי מול הארון") }}</dt><dd>{% if p.clearance %}{{ num(p.clearance) }}{% else %}{{ t("לא נמסר") }}{% endif %}</dd></div>
        <div><dt>{{ t("מרחב פתיחה מול הארון") }}</dt><dd>{% if p.reach %}{{ num(p.reach | mm) }}{% else %}{{ p.reach_label }}{% endif %}</dd></div>
      </dl>
    </div>
    <div>
      <h3>{{ t("לבדוק באתר לפני ייצור") }}</h3>
      <ul class="checks">
{% for check in p.checks %}
        <li>{{ check }}</li>
{% endfor %}
      </ul>
    </div>
