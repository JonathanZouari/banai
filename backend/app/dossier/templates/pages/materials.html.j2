    <div>
      <h3>שיטת בנייה מוצהרת</h3>
      <ol class="lead method">
{% for step in p.method %}
        <li>{{ step }}</li>
{% endfor %}
      </ol>
    </div>
    <div>
      <h3>לוחות</h3>
      <table>
        <thead><tr><th>לוח</th><th>חומר</th><th>גימור</th><th class="n">עובי</th><th>שימוש</th><th class="n">לוחות</th><th class="n">קנט (מ׳)</th></tr></thead>
        <tbody>
{% for row in p.boards %}
          <tr>
            <td>{{ row.board | swatch }}{{ row.board.color }}</td>
            <td>{{ row.board.material }}</td>
            <td>{{ row.board.finish }}</td>
            <td class="n">{{ row.board.thickness }}</td>
            <td>{{ row.uses }}</td>
            <td class="n">{{ row.sheets }}</td>
            <td class="n">{% if row.edge %}{{ row.edge }}{% elif row.board.edging is none and row.board.kind == "mdf" %}צבע{% else %}—{% endif %}</td>
          </tr>
{% endfor %}
        </tbody>
      </table>
    </div>
    <div>
      <h3>פרזול</h3>
      <table>
        <thead><tr><th>פריט</th><th class="n">כמות</th><th>מפרט</th><th>מקור</th></tr></thead>
        <tbody>
{% for h in p.hardware %}
          <tr><td>{{ h.name | ltr }}</td><td class="n">{{ h.qty }}</td><td>{{ h.spec | ltr }}</td><td class="muted">{{ num(h.src) }}</td></tr>
{% endfor %}
        </tbody>
      </table>
    </div>
