APP_ENV=local
CORS_ORIGINS=http://localhost:5173
# Filled in later milestones (never commit real values):
# AI designer (Phase 5). Without a key the chat says the agent is not connected.
OPENAI_API_KEY=
# Optional; defaults to gpt-5.4-mini (app/config.py). OPENAI_TEMPERATURE only applies when this is set.
OPENAI_CHAT_MODEL=
OPENAI_IMAGE_MODEL=
# Optional voice chat and agent tuning (defaults shown; configurable prototype values, not business rules):
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=marin
# OPENAI_TEMPERATURE=0.2
# VOICE_RATE_LIMIT=30/minute
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# HMAC key for AI proposals. Required outside APP_ENV=local (64 hex chars recommended).
PROPOSAL_SIGNING_KEY=
