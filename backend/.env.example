APP_ENV=local
CORS_ORIGINS=http://localhost:5173
# Filled in later milestones (never commit real values):
# The OpenAI key is never set here: it stays in the customer's browser and comes with each request.
# Optional model overrides; empty = pick a current model from the key's own model list.
OPENAI_CHAT_MODEL=
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
# Default reply voice (ADR-028) when the browser sends none; empty = cedar.
OPENAI_TTS_VOICE=
OPENAI_IMAGE_MODEL=
# Saved projects (ADR-042): the project URL and the service (secret) key. Only this backend uses them.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# auto (default): Supabase when both are set, otherwise saving to the server is off. memory: rows in this process
# (tests and the E2E server). off: never.
STORAGE=
# HMAC key for chat proposals (ADR-020). Empty = a random key per process (proposals expire on restart).
PROPOSAL_SECRET=
