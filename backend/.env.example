APP_ENV=local
CORS_ORIGINS=http://localhost:5173
# Filled in later milestones (never commit real values):
# AI designer (Phase 5). Without a key the chat says the agent is not connected.
OPENAI_API_KEY=
# Optional; defaults to gpt-5.4-mini (app/config.py).
OPENAI_CHAT_MODEL=
OPENAI_IMAGE_MODEL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Voice for the AI designer (ElevenLabs; the free plan works, non-commercial). Without a key the
# designer can still read replies with the browser's own voice, but there is no microphone.
ELEVENLABS_API_KEY=
# Optional; defaults in app/config.py (eleven_v3 / scribe_v2 support Hebrew).
ELEVENLABS_VOICE_ID=
ELEVENLABS_TTS_MODEL=
ELEVENLABS_STT_MODEL=
# HMAC key for AI proposals. Required outside APP_ENV=local (64 hex chars recommended).
PROPOSAL_SIGNING_KEY=
