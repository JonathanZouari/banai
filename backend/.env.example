APP_ENV=local
CORS_ORIGINS=http://localhost:5173
# Never commit real values. The OpenAI key is server-only (never put it in frontend/.env).
OPENAI_API_KEY=
# Configurable default, not a business rule:
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# 64+ random hex chars, e.g. `openssl rand -hex 32`. Required for the agent.
PROPOSAL_SIGNING_KEY=

# Voice (off by default). Spend guards: clip length, rate limit, hourly cap and a daily budget.
VOICE_ENABLED=false
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# VOICE_DAILY_BUDGET_USD=1.0
