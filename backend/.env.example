APP_ENV=local
CORS_ORIGINS=http://localhost:5173
# Never commit real values. The OpenAI key is server-only (never put it in frontend/.env).
# AI designer (Phase 5). Without a key the chat says the agent is not connected.
OPENAI_API_KEY=
# Optional; defaults to gpt-5.4-mini (app/config.py).
OPENAI_CHAT_MODEL=
OPENAI_IMAGE_MODEL=
# Saved designs (Phase 7): https://<ref>.supabase.co and the project's secret key (sb_secret_...).
# Empty with APP_ENV=local = an in-memory store that forgets on restart; empty elsewhere = saving is off.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# HMAC key for AI proposals. Required outside APP_ENV=local (64 hex chars, e.g. `openssl rand -hex 32`).
PROPOSAL_SIGNING_KEY=

# Voice (off by default). Spend guards: clip length, rate limit, hourly cap and a daily budget.
VOICE_ENABLED=false
# Optional; empty = defaults in app/api/voice.py: gpt-4o-mini-transcribe, gpt-4o-mini-tts, marin.
OPENAI_TRANSCRIBE_MODEL=
OPENAI_TTS_MODEL=
OPENAI_TTS_VOICE=
# VOICE_DAILY_BUDGET_USD=1.0

# Abuse guards (configurable defaults). FORWARDED_HOPS: trusted proxies that append to X-Forwarded-For
# (0 = off, use the connecting address). On Railway set it only after checking the header on the deployment.
FORWARDED_HOPS=0
# MIN_SHELF_GAP_MM=150   (least clear space between shelves the AI designer proposes)
# DESIGNS_RATE_LIMIT=30/minute
# DESIGNS_HOURLY_CAP=200
# EXPORT_RATE_LIMIT=10/minute
# DESIGNS_DAILY_BYTES=25000000
