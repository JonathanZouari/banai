[
  {
    "name": "add_door_shelf appends with the default depth and no appearance override",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}],
    "expect": {"match": {"doors": {"items": [{"shelves": [{"id": "dsh_1", "y": 500, "depth": 100, "appearance": null}]}, {"shelves": []}]}}}
  },
  {
    "name": "add_door_shelf with an explicit depth",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1", "depth": 80}],
    "expect": {"match": {"doors": {"items": [{"shelves": [{"id": "dsh_1", "y": 500, "depth": 80, "appearance": null}]}, {"shelves": []}]}}}
  },
  {
    "name": "add_door_shelf without an id generates one",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_b", "y": 300}],
    "expect": {"match": {"doors": {"items": [{"shelves": []}, {"shelves": [{"y": 300, "depth": 100}]}]}}}
  },
  {
    "name": "add_door_shelf onto an unknown door",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_zzz", "y": 500, "id": "dsh_1"}],
    "expect": {"error": {"code": "NOT_FOUND", "path": "ops[0].doorId"}}
  },
  {
    "name": "add_door_shelf needs hinged doors",
    "base": "two",
    "ops": [{"op": "configure_doors", "type": "sliding", "ids": ["dr_s1", "dr_s2"]}, {"op": "add_door_shelf", "doorId": "dr_s1", "y": 500, "id": "dsh_1"}],
    "expect": {"error": {"code": "INVALID_OP", "path": "ops[1].doorId"}}
  },
  {
    "name": "door shelves on the same door may not overlap",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "add_door_shelf", "doorId": "dr_a", "y": 505, "id": "dsh_2"}],
    "expect": {"error": {"code": "OVERLAP", "path": "doors.items[0].shelves[1]"}}
  },
  {
    "name": "door shelves may touch",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "add_door_shelf", "doorId": "dr_a", "y": 512, "id": "dsh_2"}],
    "expect": {"match": {"doors": {"items": [{"shelves": [{"id": "dsh_1", "y": 500, "depth": 100, "appearance": null}, {"id": "dsh_2", "y": 512, "depth": 100, "appearance": null}]}, {"shelves": []}]}}}
  },
  {
    "name": "door shelves on different doors never overlap each other",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "add_door_shelf", "doorId": "dr_b", "y": 500, "id": "dsh_2"}],
    "expect": {"match": {"doors": {"items": [{"shelves": [{"id": "dsh_1", "y": 500, "depth": 100, "appearance": null}]}, {"shelves": [{"id": "dsh_2", "y": 500, "depth": 100, "appearance": null}]}]}}}
  },
  {
    "name": "a door shelf above the interior is out of bounds",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 1950, "id": "dsh_1"}],
    "expect": {"error": {"code": "OUT_OF_BOUNDS", "path": "doors.items[0].shelves[0].y"}}
  },
  {
    "name": "a door shelf below the interior is out of bounds",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": -1, "id": "dsh_1"}],
    "expect": {"error": {"code": "OUT_OF_BOUNDS", "path": "doors.items[0].shelves[0].y"}}
  },
  {
    "name": "a door shelf too deep is out of range",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1", "depth": 151}],
    "expect": {"error": {"code": "OUT_OF_RANGE", "path": "doors.items[0].shelves[0].depth"}}
  },
  {
    "name": "a door shelf too shallow is out of range",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1", "depth": 59}],
    "expect": {"error": {"code": "OUT_OF_RANGE", "path": "doors.items[0].shelves[0].depth"}}
  },
  {
    "name": "a duplicate door shelf id is rejected",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "add_door_shelf", "doorId": "dr_a", "y": 900, "id": "dsh_1"}],
    "expect": {"error": {"code": "DUPLICATE_ID", "path": "doors.items[0].shelves[1].id"}}
  },
  {
    "name": "add_door_shelf rejects an id of another type",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "shf_9"}],
    "expect": {"error": {"code": "SCHEMA_INVALID", "path": "ops[0]"}}
  },
  {
    "name": "add_door_shelf rejects unknown fields",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1", "thickness": 18}],
    "expect": {"error": {"code": "SCHEMA_INVALID", "path": "ops[0]"}}
  },
  {
    "name": "modify_door_shelf changes y and depth",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "modify_door_shelf", "id": "dsh_1", "y": 700, "depth": 140}],
    "expect": {"match": {"doors": {"items": [{"shelves": [{"id": "dsh_1", "y": 700, "depth": 140, "appearance": null}]}, {"shelves": []}]}}}
  },
  {
    "name": "modify_door_shelf with nothing to change",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "modify_door_shelf", "id": "dsh_1"}],
    "expect": {"error": {"code": "INVALID_OP", "path": "ops[1]"}}
  },
  {
    "name": "modify_door_shelf of an unknown shelf",
    "base": "two",
    "ops": [{"op": "modify_door_shelf", "id": "dsh_zzz", "y": 100}],
    "expect": {"error": {"code": "NOT_FOUND", "path": "ops[0].id"}}
  },
  {
    "name": "modify_door_shelf into another door shelf overlaps",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "add_door_shelf", "doorId": "dr_a", "y": 900, "id": "dsh_2"}, {"op": "modify_door_shelf", "id": "dsh_2", "y": 495}],
    "expect": {"error": {"code": "OVERLAP", "path": "doors.items[0].shelves[1]"}}
  },
  {
    "name": "remove_component removes a door shelf",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "add_door_shelf", "doorId": "dr_a", "y": 900, "id": "dsh_2"}, {"op": "remove_component", "id": "dsh_1"}],
    "expect": {"match": {"doors": {"items": [{"shelves": [{"id": "dsh_2", "y": 900, "depth": 100, "appearance": null}]}, {"shelves": []}]}}}
  },
  {
    "name": "set_material on a door shelf starts from the door appearance",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "set_material", "target": "dsh_1", "color": {"catalogId": "black"}}],
    "expect": {"match": {"doors": {"items": [{"shelves": [{"id": "dsh_1", "y": 500, "depth": 100, "appearance": {"material": {"catalogId": "melamine"}, "color": {"catalogId": "black"}, "finish": {"catalogId": "matte"}}}]}, {"shelves": []}]}}}
  },
  {
    "name": "set_material on a door shelf inherits a door override",
    "base": "two",
    "ops": [{"op": "set_material", "target": "dr_a", "color": {"catalogId": "black"}}, {"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "set_material", "target": "dsh_1", "finish": {"catalogId": "gloss"}}],
    "expect": {"match": {"doors": {"items": [{"shelves": [{"id": "dsh_1", "y": 500, "depth": 100, "appearance": {"material": {"catalogId": "melamine"}, "color": {"catalogId": "black"}, "finish": {"catalogId": "gloss"}}}]}, {"shelves": []}]}}}
  },
  {
    "name": "set_material clear removes a door shelf override",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "set_material", "target": "dsh_1", "color": {"catalogId": "black"}}, {"op": "set_material", "target": "dsh_1", "clear": true}],
    "expect": {"match": {"doors": {"items": [{"shelves": [{"id": "dsh_1", "y": 500, "depth": 100, "appearance": null}]}, {"shelves": []}]}}}
  },
  {
    "name": "an unknown catalog id on a door shelf is rejected",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "set_material", "target": "dsh_1", "color": {"catalogId": "no_such_colour"}}],
    "expect": {"error": {"code": "UNKNOWN_CATALOG_ID", "path": "doors.items[0].shelves[0].appearance.color"}}
  },
  {
    "name": "re-stating hinged doors with the same ids keeps their shelves (hinge-side change)",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "configure_doors", "type": "hinged", "doors": [{"id": "dr_a", "compartmentIds": ["cmp_a"], "hingeSide": "right"}, {"id": "dr_b", "compartmentIds": ["cmp_b"], "hingeSide": "left"}]}],
    "expect": {"match": {"doors": {"type": "hinged", "items": [{"id": "dr_a", "hingeSide": "right", "shelves": [{"id": "dsh_1", "y": 500, "depth": 100, "appearance": null}]}, {"id": "dr_b", "hingeSide": "left", "shelves": []}]}}}
  },
  {
    "name": "re-stating hinged doors with new ids drops the old doors' shelves",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "configure_doors", "type": "hinged", "ids": ["dr_x", "dr_y"]}],
    "expect": {"match": {"doors": {"items": [{"shelves": []}, {"shelves": []}]}}}
  },
  {
    "name": "switching to sliding doors drops door shelves",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "configure_doors", "type": "sliding", "ids": ["dr_s1", "dr_s2"]}],
    "expect": {"match": {"doors": {"type": "sliding", "items": [{"shelves": []}, {"shelves": []}]}}}
  },
  {
    "name": "removing a compartment drops its door and that door's shelves",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "add_door_shelf", "doorId": "dr_b", "y": 900, "id": "dsh_2"}, {"op": "remove_component", "id": "cmp_a"}],
    "expect": {"match": {"doors": {"items": [{"id": "dr_b", "shelves": [{"id": "dsh_2", "y": 900, "depth": 100, "appearance": null}]}]}}}
  },
  {
    "name": "removing a door removes its shelves",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 500, "id": "dsh_1"}, {"op": "remove_component", "id": "dr_a"}],
    "expect": {"match": {"doors": {"items": [{"id": "dr_b", "shelves": []}]}}}
  },
  {
    "name": "removing a partition merges door shelves onto the surviving door",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 300, "id": "dsh_1"}, {"op": "add_door_shelf", "doorId": "dr_b", "y": 900, "id": "dsh_2"}, {"op": "remove_component", "id": "prt_ab"}],
    "expect": {"match": {"doors": {"items": [{"id": "dr_a", "compartmentIds": ["cmp_a"], "shelves": [{"id": "dsh_1", "y": 300, "depth": 100, "appearance": null}, {"id": "dsh_2", "y": 900, "depth": 100, "appearance": null}]}]}}}
  },
  {
    "name": "removing a partition is rejected when merged door shelves overlap",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 300, "id": "dsh_1"}, {"op": "add_door_shelf", "doorId": "dr_b", "y": 305, "id": "dsh_2"}, {"op": "remove_component", "id": "prt_ab"}],
    "expect": {"error": {"code": "OVERLAP", "path": "doors.items[0].shelves[1]"}}
  },
  {
    "name": "adding a partition keeps the door shelves",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 300, "id": "dsh_1"}, {"op": "add_partition", "compartmentId": "cmp_a", "offset": 200, "id": "prt_n", "newCompartmentId": "cmp_n"}],
    "expect": {"match": {"doors": {"items": [{"id": "dr_a", "compartmentIds": ["cmp_a", "cmp_n"], "shelves": [{"id": "dsh_1", "y": 300, "depth": 100, "appearance": null}]}, {"id": "dr_b", "shelves": []}]}}}
  },
  {
    "name": "lowering the height under a door shelf is rejected",
    "base": "two",
    "ops": [{"op": "add_door_shelf", "doorId": "dr_a", "y": 1900, "id": "dsh_1"}, {"op": "update_dimensions", "height": 1950}],
    "expect": {"error": {"code": "OUT_OF_BOUNDS", "path": "doors.items[0].shelves[0].y"}}
  },
  {
    "name": "a sliding door carrying shelves is invalid",
    "base": "two",
    "mutate": [{"path": ["doors"], "value": {"type": "sliding", "appearance": {"material": {"catalogId": "melamine"}, "color": {"catalogId": "white"}, "finish": {"catalogId": "matte"}}, "items": [{"id": "dr_s1", "compartmentIds": [], "hingeSide": null, "appearance": null, "shelves": [{"id": "dsh_1", "y": 500, "depth": 100, "appearance": null}]}, {"id": "dr_s2", "compartmentIds": [], "hingeSide": null, "appearance": null, "shelves": []}]}}],
    "ops": [],
    "expect": {"error": {"code": "DOOR_INVALID", "path": "doors.items[0].shelves"}}
  },
  {
    "name": "a saved design without door shelves loads with empty shelf lists",
    "base": "two",
    "mutate": [{"path": ["doors"], "value": {"type": "hinged", "appearance": {"material": {"catalogId": "melamine"}, "color": {"catalogId": "white"}, "finish": {"catalogId": "matte"}}, "items": [{"id": "dr_a", "compartmentIds": ["cmp_a"], "hingeSide": "left", "appearance": null}, {"id": "dr_b", "compartmentIds": ["cmp_b"], "hingeSide": "right", "appearance": null}]}}],
    "ops": [],
    "expect": {"match": {"doors": {"items": [{"shelves": []}, {"shelves": []}]}}}
  },
