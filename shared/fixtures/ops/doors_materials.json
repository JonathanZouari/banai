[
  {
    "name": "configure sliding doors",
    "base": "two",
    "ops": [{ "op": "configure_doors", "type": "sliding", "count": 2, "ids": ["dr_s1", "dr_s2"] }],
    "expect": { "match": { "doors": { "type": "sliding", "items": [
      { "id": "dr_s1", "compartmentIds": [], "hingeSide": null, "appearance": null },
      { "id": "dr_s2", "compartmentIds": [], "hingeSide": null, "appearance": null }
    ] } } }
  },
  {
    "name": "configure hinged doors defaults to one per compartment, alternating hinges",
    "base": "two",
    "ops": [{ "op": "configure_doors", "type": "hinged", "ids": ["dr_x", "dr_y"] }],
    "expect": { "match": { "doors": { "type": "hinged", "items": [
      { "id": "dr_x", "compartmentIds": ["cmp_a"], "hingeSide": "left" },
      { "id": "dr_y", "compartmentIds": ["cmp_b"], "hingeSide": "right" }
    ] } } }
  },
  {
    "name": "a compartment covered by two hinged doors is invalid",
    "base": "two",
    "ops": [{ "op": "configure_doors", "type": "hinged", "doors": [
      { "id": "dr_1", "compartmentIds": ["cmp_a"], "hingeSide": "left" },
      { "id": "dr_2", "compartmentIds": ["cmp_a", "cmp_b"], "hingeSide": "right" }
    ] }],
    "expect": { "error": { "code": "DOOR_INVALID", "path": "doors.items[1].compartmentIds" } }
  },
  {
    "name": "sliding door count out of range",
    "base": "two",
    "ops": [{ "op": "configure_doors", "type": "sliding", "count": 9 }],
    "expect": { "error": { "code": "OUT_OF_RANGE", "path": "ops[0].count" } }
  },
  {
    "name": "configure no doors",
    "base": "two",
    "ops": [{ "op": "configure_doors", "type": "none" }],
    "expect": { "match": { "doors": { "type": "none", "items": [] } } }
  },
  {
    "name": "removing the last door switches type to none",
    "base": "two",
    "ops": [{ "op": "remove_component", "id": "dr_a" }, { "op": "remove_component", "id": "dr_b" }],
    "expect": { "match": { "doors": { "type": "none", "items": [] } } }
  },
  {
    "name": "set a custom carcass colour",
    "base": "two",
    "ops": [{ "op": "set_material", "target": "carcass", "color": { "custom": true, "name": "Sage green", "hex": "#9caf88" } }],
    "expect": { "match": { "carcass": { "appearance": {
      "material": { "catalogId": "melamine" },
      "color": { "custom": true, "name": "Sage green", "hex": "#9caf88" },
      "finish": { "catalogId": "matte" }
    } } } }
  },
  {
    "name": "unknown catalog colour",
    "base": "two",
    "ops": [{ "op": "set_material", "target": "carcass", "color": { "catalogId": "pink" } }],
    "expect": { "error": { "code": "UNKNOWN_CATALOG_ID", "path": "carcass.appearance.color" } }
  },
  {
    "name": "shelf override inherits the carcass appearance",
    "base": "two",
    "ops": [{ "op": "set_material", "target": "shf_1", "finish": { "catalogId": "gloss" } }],
    "expect": { "match": { "compartments": [{ "shelves": [{ "appearance": {
      "material": { "catalogId": "melamine" }, "color": { "catalogId": "white" }, "finish": { "catalogId": "gloss" }
    } }] }, {}] } }
  },
  {
    "name": "custom material without hex gets hex null",
    "base": "two",
    "ops": [{ "op": "set_material", "target": "doors", "material": { "custom": true, "name": "Rattan panels" } }],
    "expect": { "match": { "doors": { "appearance": { "material": { "custom": true, "name": "Rattan panels", "hex": null } } } } }
  },
  {
    "name": "clear a door override",
    "base": "two",
    "ops": [
      { "op": "set_material", "target": "dr_a", "color": { "catalogId": "walnut" } },
      { "op": "set_material", "target": "dr_a", "clear": true }
    ],
    "expect": { "match": { "doors": { "items": [{ "id": "dr_a", "appearance": null }, {}] } } }
  },
  {
    "name": "rails have no appearance",
    "base": "two",
    "ops": [{ "op": "set_material", "target": "rail_1", "color": { "catalogId": "black" } }],
    "expect": { "error": { "code": "INVALID_OP", "path": "ops[0].target" } }
  },
  {
    "name": "set_material needs at least one field",
    "base": "two",
    "ops": [{ "op": "set_material", "target": "carcass" }],
    "expect": { "error": { "code": "INVALID_OP", "path": "ops[0]" } }
  },
  {
    "name": "set handle style and finish for every door",
    "base": "two",
    "ops": [{ "op": "set_handles", "style": "knob", "finish": "brass" }],
    "expect": { "match": { "doors": { "handles": { "style": "knob", "finish": "brass" } } } }
  },
  {
    "name": "set_handles changes only the given field",
    "base": "two",
    "ops": [{ "op": "set_handles", "style": "none" }],
    "expect": { "match": { "doors": { "handles": { "style": "none", "finish": "black" } } } }
  },
  {
    "name": "set_handles rejects an unknown handle style",
    "base": "two",
    "ops": [{ "op": "set_handles", "style": "gold_lion" }],
    "expect": { "error": { "code": "UNKNOWN_CATALOG_ID", "path": "doors.handles.style" } }
  },
  {
    "name": "set_handles needs a style or a finish",
    "base": "two",
    "ops": [{ "op": "set_handles", "style": null }],
    "expect": { "error": { "code": "INVALID_OP", "path": "ops[0]" } }
  },
  {
    "name": "make one hinged door a mirror, then back to a panel",
    "base": "two",
    "ops": [{ "op": "modify_door", "id": "dr_b", "front": "mirror" }],
    "expect": { "match": { "doors": { "items": [{ "id": "dr_a", "front": "panel" }, { "id": "dr_b", "front": "mirror" }] } } }
  },
  {
    "name": "mirror fronts work on sliding doors too",
    "base": "two",
    "ops": [
      { "op": "configure_doors", "type": "sliding", "count": 3, "ids": ["dr_s1", "dr_s2", "dr_s3"] },
      { "op": "modify_door", "id": "dr_s2", "front": "mirror" },
      { "op": "modify_door", "id": "dr_s3", "front": "mirror" }
    ],
    "expect": { "match": { "doors": { "type": "sliding", "items": [{ "front": "panel" }, { "front": "mirror" }, { "front": "mirror" }] } } }
  },
  {
    "name": "modify_door needs an existing door",
    "base": "two",
    "ops": [{ "op": "modify_door", "id": "dr_nope", "front": "mirror" }],
    "expect": { "error": { "code": "NOT_FOUND", "path": "ops[0].id" } }
  },
  {
    "name": "modify_door rejects an unknown front",
    "base": "two",
    "ops": [{ "op": "modify_door", "id": "dr_a", "front": "glass" }],
    "expect": { "error": { "code": "SCHEMA_INVALID" } }
  },
  {
    "name": "re-stating hinged doors keeps each surviving door's front and finish",
    "base": "two",
    "ops": [
      { "op": "modify_door", "id": "dr_a", "front": "mirror" },
      { "op": "set_material", "target": "dr_b", "color": { "catalogId": "walnut" } },
      { "op": "configure_doors", "type": "hinged", "doors": [
        { "id": "dr_a", "compartmentIds": ["cmp_a"], "hingeSide": "right" },
        { "id": "dr_b", "compartmentIds": ["cmp_b"], "hingeSide": "left" }
      ] }
    ],
    "expect": { "match": { "doors": { "items": [
      { "id": "dr_a", "hingeSide": "right", "front": "mirror", "appearance": null },
      { "id": "dr_b", "hingeSide": "left", "front": "panel", "appearance": { "color": { "catalogId": "walnut" } } }
    ] } } }
  },
  {
    "name": "new door ids start as plain panels",
    "base": "two",
    "ops": [
      { "op": "modify_door", "id": "dr_a", "front": "mirror" },
      { "op": "configure_doors", "type": "sliding", "count": 2, "ids": ["dr_s1", "dr_s2"] }
    ],
    "expect": { "match": { "doors": { "items": [{ "id": "dr_s1", "front": "panel", "appearance": null }, { "id": "dr_s2", "front": "panel" }] } } }
  }
]
