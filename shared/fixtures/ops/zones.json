          {
            "id": "cmp_middle"
          },
          {
            "id": "cmp_right"
          }
        ],
        "doors": {
          "items": [
            {
              "id": "dr_left_z1",
              "compartmentIds": [
                "cmp_left"
              ],
              "hingeSide": "left",
              "bottomShelfId": null,
              "topShelfId": "shf_l2"
            },
            {
              "id": "dr_left_z2",
              "compartmentIds": [
                "cmp_left"
              ],
              "hingeSide": "left",
              "bottomShelfId": "shf_l2",
