[
  {
    "name": "modify_compartment: right neighbour absorbs the difference",
    "base": "two",
    "ops": [{ "op": "modify_compartment", "compartmentId": "cmp_a", "width": 400 }],
    "expect": { "match": { "compartments": [{ "width": 400 }, { "width": 540 }] } }
  },
  {
    "name": "modify_compartment: last compartment takes from the left neighbour",
    "base": "two",
    "ops": [{ "op": "modify_compartment", "compartmentId": "cmp_b", "width": 500 }],
    "expect": { "match": { "compartments": [{ "width": 440 }, { "width": 500 }] } }
  },
  {
    "name": "modify_compartment leaving the neighbour too narrow",
    "base": "two",
    "ops": [{ "op": "modify_compartment", "compartmentId": "cmp_a", "width": 900 }],
    "expect": { "error": { "code": "OUT_OF_RANGE", "path": "ops[0].width" } }
  },
  {
    "name": "add_compartment at the end takes space from the last compartment",
    "base": "two",
    "ops": [{ "op": "add_compartment", "position": 2, "width": 300, "id": "cmp_c", "partitionId": "prt_bc" }],
    "expect": { "match": {
      "compartments": [
        { "id": "cmp_a", "width": 470 },
        { "id": "cmp_b", "width": 150 },
        { "id": "cmp_c", "width": 300, "shelves": [], "drawers": [], "rails": [] }
      ],
      "partitions": [{ "id": "prt_ab" }, { "id": "prt_bc", "thickness": 20 }]
    } }
  },
  {
    "name": "add_compartment at the start takes space from the compartment at that position",
    "base": "two",
    "ops": [{ "op": "add_compartment", "position": 0, "width": 200, "id": "cmp_z", "partitionId": "prt_z" }],
    "expect": { "match": {
      "compartments": [{ "id": "cmp_z", "width": 200 }, { "id": "cmp_a", "width": 250 }, { "id": "cmp_b", "width": 470 }],
      "partitions": [{ "id": "prt_z" }, { "id": "prt_ab" }]
    } }
  },
  {
    "name": "add_partition splits a compartment; items stay left, doors extend",
    "base": "two",
    "ops": [{ "op": "add_partition", "compartmentId": "cmp_b", "offset": 200, "id": "prt_new", "newCompartmentId": "cmp_new" }],
    "expect": { "match": {
      "compartments": [
        { "id": "cmp_a" },
        { "id": "cmp_b", "width": 200, "rails": [{ "id": "rail_1" }] },
        { "id": "cmp_new", "width": 250, "rails": [] }
      ],
      "partitions": [{ "id": "prt_ab" }, { "id": "prt_new", "thickness": 20 }],
      "doors": { "items": [{ "id": "dr_a" }, { "id": "dr_b", "compartmentIds": ["cmp_b", "cmp_new"] }] }
    } }
  },
  {
    "name": "add_partition too close to the edge",
    "base": "two",
    "ops": [{ "op": "add_partition", "compartmentId": "cmp_b", "offset": 20 }],
    "expect": { "error": { "code": "OUT_OF_RANGE", "path": "ops[0].offset" } }
  },
  {
    "name": "modify_partition moves it; only neighbours change",
    "base": "two",
    "ops": [{ "op": "modify_partition", "partitionId": "prt_ab", "position": 500 }],
    "expect": { "match": { "compartments": [{ "width": 500 }, { "width": 440 }] } }
  },
  {
    "name": "modify_partition thickness takes space from the right neighbour",
    "base": "two",
    "ops": [{ "op": "modify_partition", "partitionId": "prt_ab", "thickness": 30 }],
    "expect": { "match": { "compartments": [{ "width": 470 }, { "width": 460 }], "partitions": [{ "thickness": 30 }] } }
  },
  {
    "name": "remove a shelf",
    "base": "two",
    "ops": [{ "op": "remove_component", "id": "shf_1" }],
    "expect": { "match": { "compartments": [{ "shelves": [] }, {}] } }
  },
  {
    "name": "remove a compartment: right neighbour absorbs it, its door is dropped",
    "base": "two",
    "ops": [{ "op": "remove_component", "id": "cmp_a" }],
    "expect": { "match": {
      "compartments": [{ "id": "cmp_b", "width": 960 }],
      "partitions": [],
      "doors": { "type": "hinged", "items": [{ "id": "dr_b", "compartmentIds": ["cmp_b"] }] }
    } }
  },
  {
    "name": "remove a partition: compartments merge left and doors merge",
    "base": "two",
    "ops": [{ "op": "remove_component", "id": "prt_ab" }],
    "expect": { "match": {
      "compartments": [{ "id": "cmp_a", "width": 960, "shelves": [{ "id": "shf_1" }], "drawers": [{ "id": "drw_1" }], "rails": [{ "id": "rail_1" }] }],
      "partitions": [],
      "doors": { "items": [{ "id": "dr_a", "compartmentIds": ["cmp_a"] }] }
    } }
  },
  {
    "name": "the last compartment cannot be removed",
    "base": "two",
    "ops": [{ "op": "remove_component", "id": "cmp_a" }, { "op": "remove_component", "id": "cmp_b" }],
    "expect": { "error": { "code": "INVALID_OP", "path": "ops[1].id" } }
  },
  {
    "name": "remove unknown component",
    "base": "two",
    "ops": [{ "op": "remove_component", "id": "shf_zzz" }],
    "expect": { "error": { "code": "NOT_FOUND", "path": "ops[0].id" } }
  },
  {
    "name": "mirror_layout reverses compartments; ids and contents stay with each compartment",
    "base": "two",
    "ops": [{ "op": "mirror_layout" }],
    "expect": { "match": {
      "dimensions": { "width": 1000 },
      "compartments": [
        { "id": "cmp_b", "width": 470, "shelves": [], "drawers": [], "rails": [{ "id": "rail_1", "y": 1700 }] },
        { "id": "cmp_a", "width": 470, "shelves": [{ "id": "shf_1", "y": 500 }], "drawers": [{ "id": "drw_1", "y": 0 }], "rails": [] }
      ],
      "partitions": [{ "id": "prt_ab", "thickness": 20 }],
      "doors": { "type": "hinged", "items": [
        { "id": "dr_b", "compartmentIds": ["cmp_b"], "hingeSide": "left" },
        { "id": "dr_a", "compartmentIds": ["cmp_a"], "hingeSide": "right" }
      ] }
    } }
  },
  {
    "name": "mirror_layout reverses unequal partitions and widths (width invariant holds)",
    "base": "basic",
    "mutate": [
      { "path": ["partitions", 0, "thickness"], "value": 30 },
      { "path": ["compartments", 0, "width"], "value": 631 }
    ],
    "ops": [{ "op": "mirror_layout" }],
    "expect": { "match": {
      "dimensions": { "width": 2000 },
      "carcass": { "panelThickness": 18 },
      "compartments": [{ "id": "cmp_right", "width": 642 }, { "id": "cmp_middle", "width": 643 }, { "id": "cmp_left", "width": 631 }],
      "partitions": [{ "id": "prt_2", "thickness": 18 }, { "id": "prt_1", "thickness": 30 }]
    } }
  },
  {
    "name": "mirror_layout keeps a spanning hinged door in left-to-right order and swaps its hinge",
    "base": "two",
    "ops": [
      { "op": "configure_doors", "type": "hinged", "doors": [{ "id": "dr_wide", "compartmentIds": ["cmp_a", "cmp_b"], "hingeSide": "left" }] },
      { "op": "mirror_layout" }
    ],
    "expect": { "match": {
      "doors": { "type": "hinged", "items": [{ "id": "dr_wide", "compartmentIds": ["cmp_b", "cmp_a"], "hingeSide": "right" }] }
    } }
  },
  {
    "name": "mirror_layout reverses the order of sliding panels",
    "base": "two",
    "ops": [
      { "op": "configure_doors", "type": "sliding", "ids": ["dr_1", "dr_2", "dr_3"] },
      { "op": "mirror_layout" }
    ],
    "expect": { "match": {
      "doors": { "type": "sliding", "items": [
        { "id": "dr_3", "compartmentIds": [], "hingeSide": null },
        { "id": "dr_2", "compartmentIds": [], "hingeSide": null },
        { "id": "dr_1", "compartmentIds": [], "hingeSide": null }
      ] }
    } }
  },
  {
    "name": "mirror_layout without doors only reverses the compartments",
    "base": "two",
    "ops": [{ "op": "configure_doors", "type": "none" }, { "op": "mirror_layout" }],
    "expect": { "match": {
      "compartments": [{ "id": "cmp_b" }, { "id": "cmp_a" }],
      "doors": { "type": "none", "items": [] }
    } }
  },
  {
    "name": "mirror_layout twice restores the original layout",
    "base": "basic",
    "ops": [{ "op": "mirror_layout" }, { "op": "mirror_layout" }],
    "expect": { "match": {
      "compartments": [{ "id": "cmp_left" }, { "id": "cmp_middle" }, { "id": "cmp_right" }],
      "partitions": [{ "id": "prt_1" }, { "id": "prt_2" }],
      "doors": { "items": [
        { "id": "dr_left", "hingeSide": "left" },
        { "id": "dr_middle", "hingeSide": "right" },
        { "id": "dr_right", "hingeSide": "left" }
      ] }
    } }
  },
  {
    "name": "mirror_layout takes no fields",
    "base": "two",
    "ops": [{ "op": "mirror_layout", "compartmentId": "cmp_a" }],
    "expect": { "error": { "code": "SCHEMA_INVALID" } }
  }
]
